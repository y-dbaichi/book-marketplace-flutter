	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-generate timestamp for unique emails",
					"pm.globals.set('timestamp', Date.now());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-extract IDs from responses",
					"if (pm.response.json() && pm.response.json().book && pm.response.json().book._id) {",
					"    pm.globals.set('bookId', pm.response.json().book._id);",
					"}",
					"if (pm.response.json() && pm.response.json().order && pm.response.json().order._id) {",
					"    pm.globals.set('orderId', pm.response.json().order._id);",
					"}",
					"if (pm.response.json() && pm.response.json().export && pm.response.json().export.id) {",
					"    pm.globals.set('exportId', pm.response.json().export.id);",
					"}",
					"if (pm.response.json() && pm.response.json().token) {",
					"    pm.globals.set('authToken', pm.response.json().token);",
					"}",
					"if (pm.response.json() && pm.response.json().user && pm.response.json().user.userType === 'customer') {",
					"    pm.globals.set('customerAuthToken', pm.response.json().token);",
					"    pm.globals.set('customerEmail', pm.response.json().user.email);",
					"}",
					"if (pm.response.json() && pm.response.json().user && pm.response.json().user.userType === 'buyer') {",
					"    pm.globals.set('buyerAuthToken', pm.response.json().token);",
					"    pm.globals.set('buyerEmail', pm.response.json().user.email);",
					"}"
				]
			}
		}
